<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wang.business.mysqldao.TagDao">


    <update id="updateBatchStatusByIds" parameterType="list">
        update t_tag set status=0 where uid in
        <foreach item="uid" index = "index" collection="uisList"  open="(" separator="," close=")" >
            #{uid}
        </foreach>
    </update>






</mapper>
